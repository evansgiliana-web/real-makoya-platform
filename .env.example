# Postgres connection string (Neon / Vercel Postgres / Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/realmakoya?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Set to your deployed URL in production, e.g. https://realmakoya.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Used only by the seed script to create the first Super Admin account.
# There is NO default password: choose a long, unique one (10+ characters).
SEED_ADMIN_EMAIL="admin@your-company.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Real Makoya Super Admin"
# Local sandbox ONLY: also create demo logins that have publicly known passwords.
# SEED_DEMO_DATA=true

# ── Vercel Blob (required for photo and document uploads) ──
# Create a Blob store in the Vercel dashboard → Storage → Blob → copy the token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Encryption key for owner documents (ID copies, consent forms, registration papers) ──
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP in a password manager. If it is lost, encrypted documents can never be
# opened again. Never commit it. Use the same value locally and in Vercel.
DOCUMENT_ENCRYPTION_KEY=""

# ── High-risk alert emails (optional but recommended) ──
# Free tier at https://resend.com — create an API key and verify a domain (or use onboarding@resend.dev for tests)
RESEND_API_KEY=""
ALERT_EMAIL_TO="alerts@your-company.com"
ALERT_EMAIL_FROM="Real Makoya Alerts <onboarding@resend.dev>"
