# Postgres connection string (Neon / Vercel Postgres / Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/realmakoya?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Set to your deployed URL in production, e.g. https://realmakoya.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Used only by the seed script to create the first Super Admin account
SEED_ADMIN_EMAIL="admin@realmakoya.co.za"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Real Makoya Super Admin"
