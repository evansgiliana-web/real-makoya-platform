# Postgres connection string (Neon / Vercel Postgres / Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/realmakoya?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Set to your deployed URL in production, e.g. https://realmakoya.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Used only by the seed script to create the first Super Admin account
SEED_ADMIN_EMAIL="admin@realmakoya.co.za"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Real Makoya Super Admin"

# ── Vercel Blob (required for photo uploads) ──
# Create a Blob store in the Vercel dashboard → Storage → Blob → copy the token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── High-risk alert emails (optional but recommended) ──
# Free tier at https://resend.com — create an API key and verify a domain (or use onboarding@resend.dev for tests)
RESEND_API_KEY=""
ALERT_EMAIL_TO="alerts@realmakoya.co.za"
ALERT_EMAIL_FROM="Real Makoya Alerts <onboarding@resend.dev>"
