generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role
  active         Boolean         @default(true)
  invitedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assessments    Assessment[]
  auditLogs      AuditLog[]
  orgMemberships OrgMembership[]
  createdStores  Store[]
}

model Organization {
  id          String          @id @default(cuid())
  name        String
  logoUrl     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  brands      Brand[]
  memberships OrgMembership[]
}

model Brand {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  category       String?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productLines   ProductLine[]

  @@unique([organizationId, name])
}

model OrgMembership {
  id              String       @id @default(cuid())
  userId          String
  organizationId  String
  orgRole         OrgRole      @default(MEMBER)
  allBrandsAccess Boolean      @default(true)
  brandIds        String[]     @default([])
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Store {
  id                               String             @id @default(cuid())
  name                             String
  tradingAs                        String?
  address                          String
  town                             String
  province                         String
  latitude                         Float?
  longitude                        Float?
  ownerName                        String
  ownerContactNumber               String?
  ownerIdOrCompanyRegNumber        String?
  municipalRegistrationStatus      RegistrationStatus @default(UNKNOWN)
  municipalRegistrationNumber      String?
  registrationNotes                String?
  storeTelephoneNumber             String?
  storePhotoUrls                   String[]           @default([])
  ownerConsentGiven                Boolean            @default(false)
  ownerConsentAt                   DateTime?
  ownerConsentById                 String?
  piiRedacted                      Boolean            @default(false)
  piiRedactedAt                    DateTime?
  piiRedactedById                  String?
  nextVisitDue                     DateTime?
  visitCadenceDays                 Int                @default(90)
  createdById                      String
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @updatedAt
  municipalRegistrationDocumentUrl String?
  ownerConsentDocumentUrl          String?
  businessLicenseDocumentUrl       String?
  ownershipDocumentUrl             String?
  assessments                      Assessment[]
  images                           Image[]
  createdBy                        User               @relation(fields: [createdById], references: [id])
}

model Image {
  id         String   @id @default(cuid())
  category   String
  url        String
  storeId    String
  capturedAt DateTime @default(now())
  capturedBy String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Assessment {
  id                          String               @id @default(cuid())
  storeId                     String
  agentId                     String
  visitDate                   DateTime             @default(now())
  status                      AssessmentStatus     @default(SUBMITTED)
  reviewedAt                  DateTime?
  reviewedById                String?
  reviewNotes                 String?
  sourceType                  SourceType
  supplierName                String?
  supplierLocation            String?
  distributionNotes           String?
  hasValidCoA                 Boolean              @default(false)
  coaNotes                    String?
  hasHealthPermit             Boolean              @default(false)
  healthPermitNumber          String?
  healthPermitExpiry          DateTime?
  brandAuthenticityVerified   Boolean              @default(false)
  complianceNotes             String?
  counterfeitRisk             CounterfeitRisk      @default(NONE)
  packagingIssueFlag          Boolean              @default(false)
  batchCodeIssueFlag          Boolean              @default(false)
  pricingAnomalyFlag          Boolean              @default(false)
  counterfeitNotes            String?
  photoUrls                   String[]             @default([])
  totalSkuCount               Int?
  estimatedMonthlyTurnoverZar Float?
  packingShelvesCount         Int?
  posInstalled                Boolean              @default(false)
  posBrand                    String?
  posModel                    String?
  posPhotoUrls                String[]             @default([])
  internetConnectivity        InternetConnectivity @default(UNKNOWN)
  scannerInstalled            Boolean              @default(false)
  scannerDetails              String?
  equipmentPhotoUrls          String[]             @default([])
  internalNotes               String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  coaDocumentUrl              String?
  healthPermitDocumentUrl     String?
  agent                       User                 @relation(fields: [agentId], references: [id])
  store                       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productLines                ProductLine[]
}

model ProductLine {
  id                    String     @id @default(cuid())
  assessmentId          String
  category              String
  brand                 String
  rank                  Int?
  estimatedMonthlyUnits Int?
  estimatedUnitPriceZar Float?
  notes                 String?
  brandId               String?
  assessment            Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  brandRef              Brand?     @relation(fields: [brandId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String
  entityId   String
  beforeJson String?
  afterJson  String?
  metaJson   String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FIELD_AGENT
  CLIENT
}

enum OrgRole {
  OWNER
  MEMBER
}

enum RegistrationStatus {
  REGISTERED
  PENDING
  UNREGISTERED
  UNKNOWN
}

enum SourceType {
  FORMAL_WHOLESALER
  INFORMAL_BULK_BUYER
  UNVERIFIED_SUPPLIER
  MIXED
}

enum CounterfeitRisk {
  NONE
  LOW
  MEDIUM
  HIGH
  CONFIRMED_COUNTERFEIT
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FLAGGED
}

enum InternetConnectivity {
  NONE
  MOBILE_DATA
  WIFI
  FIBER
  UNKNOWN
}
