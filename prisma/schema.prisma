// Real Makoya Agency — Retail Intelligence & Compliance Platform
// Database schema (Phase 1: POPIA, QA review, visit cadence, audit log)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// USERS & ACCESS CONTROL
// ──────────────────────────────────────────────

enum Role {
  SUPER_ADMIN  // Full platform control, manages all users & data
  ADMIN        // Real Makoya agency management: manages field agents, stores, clients
  FIELD_AGENT  // Field capture only: can create/edit stores & assessments
  CLIENT       // FMCG company: read-only access to professional reports
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  active        Boolean  @default(true)

  // CLIENT-role users belong to an FMCG Organization through this. A user
  // normally has exactly one membership; the model allows more in case an
  // agency contact genuinely represents two companies.
  orgMemberships OrgMembership[]

  createdStores Store[]
  assessments   Assessment[]
  auditLogs     AuditLog[]

  invitedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ──────────────────────────────────────────────
// FMCG ORGANIZATIONS, BRANDS & TEAM MEMBERSHIP
// ──────────────────────────────────────────────

// An FMCG company, e.g. "Coca-Cola South Africa". Owns one or more Brands.
model Organization {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?

  brands      Brand[]
  memberships OrgMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single brand under an Organization, e.g. "Coke", "Fanta", "Sprite".
// `category` groups brands for anonymized cross-brand benchmarking
// (e.g. "Soft Drinks") without ever exposing one client's raw data to another.
model Brand {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String?

  productLines ProductLine[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
}

enum OrgRole {
  OWNER  // can invite/remove teammates and manage brand access for the org
  MEMBER // read-only, scoped to the brands granted below
}

// Joins a User to an Organization with their own role and brand scope —
// this is what lets one FMCG company have many people, each seeing only
// the brands relevant to their job.
model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orgRole         OrgRole  @default(MEMBER)
  allBrandsAccess Boolean  @default(true)
  brandIds        String[] @default([]) // only used when allBrandsAccess is false

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
}

// ──────────────────────────────────────────────
// STORE — Ownership & Registration
// ──────────────────────────────────────────────

enum RegistrationStatus {
  REGISTERED
  PENDING
  UNREGISTERED
  UNKNOWN
}

model Store {
  id        String @id @default(cuid())
  name      String
  tradingAs String?

  // Location
  address   String
  town      String
  province  String
  latitude  Float?
  longitude Float?

  // Ownership & registration
  ownerName                   String
  ownerContactNumber          String?
  ownerIdOrCompanyRegNumber   String?
  municipalRegistrationStatus RegistrationStatus @default(UNKNOWN)
  municipalRegistrationNumber String?
  registrationNotes           String?

  // Store contact & identity media
  storeTelephoneNumber String?
  storePhotoUrls       String[] @default([])

  // Categorized photo gallery
  images Image[]

  // ── POPIA / data protection ──
  // Consent must be obtained at capture time before storing owner PII
  ownerConsentGiven   Boolean   @default(false)
  ownerConsentAt      DateTime?
  ownerConsentById    String?   // user id who recorded consent
  // Soft-redaction: PII fields cleared, flag set, original values not recoverable via app
  piiRedacted         Boolean   @default(false)
  piiRedactedAt       DateTime?
  piiRedactedById     String?

  // ── Visit cadence ──
  nextVisitDue        DateTime?
  visitCadenceDays    Int       @default(90) // default 3-month revisit

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id         String   @id @default(cuid())
  category   String   // e.g. "Store Front", "Street Pole"
  url        String   // file path or cloud URL
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now())
  capturedBy String
}

// ──────────────────────────────────────────────
// ASSESSMENT — one field-capture visit
// ──────────────────────────────────────────────

enum SourceType {
  FORMAL_WHOLESALER
  INFORMAL_BULK_BUYER
  UNVERIFIED_SUPPLIER
  MIXED
}

enum CounterfeitRisk {
  NONE
  LOW
  MEDIUM
  HIGH
  CONFIRMED_COUNTERFEIT
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FLAGGED
}

enum InternetConnectivity {
  NONE
  MOBILE_DATA
  WIFI
  FIBER
  UNKNOWN
}

model Assessment {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  agentId String
  agent   User   @relation(fields: [agentId], references: [id])

  visitDate DateTime         @default(now())
  status    AssessmentStatus @default(SUBMITTED)

  // ── QA / Review layer ──
  // Client reports only count assessments with status = REVIEWED
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNotes    String?

  // ── Top-selling product lines ──
  productLines ProductLine[]

  // ── Trade & distribution routes ──
  sourceType        SourceType
  supplierName      String?
  supplierLocation  String?
  distributionNotes String?

  // ── Compliance & CoA verification ──
  hasValidCoA               Boolean   @default(false)
  coaNotes                  String?
  hasHealthPermit           Boolean   @default(false)
  healthPermitNumber        String?
  healthPermitExpiry        DateTime?
  brandAuthenticityVerified Boolean   @default(false)
  complianceNotes           String?

  // ── Counterfeit screening ──
  counterfeitRisk    CounterfeitRisk @default(NONE)
  packagingIssueFlag Boolean         @default(false)
  batchCodeIssueFlag Boolean         @default(false)
  pricingAnomalyFlag Boolean         @default(false)
  counterfeitNotes   String?
  photoUrls          String[]        @default([])

  // ── Commercial metrics ──
  totalSkuCount               Int?
  estimatedMonthlyTurnoverZar Float?

  // ── Store infrastructure & equipment ──
  packingShelvesCount  Int?
  posInstalled         Boolean              @default(false)
  posBrand             String?
  posModel             String?
  posPhotoUrls         String[]             @default([])
  internetConnectivity InternetConnectivity @default(UNKNOWN)
  scannerInstalled     Boolean              @default(false)
  scannerDetails       String?
  equipmentPhotoUrls   String[]             @default([])

  internalNotes String? // visible to agency staff only, never shown to CLIENT role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductLine {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  category              String  // e.g. "Beverages", "Snacks", "Personal Care"
  brand                 String  // e.g. "Coca-Cola", "Omo", "Lay's" — free text, agents can log any brand they see
  rank                  Int?    // 1 = top seller at this store
  estimatedMonthlyUnits Int?
  estimatedUnitPriceZar Float?
  notes                 String?

  // Auto-matched (case-insensitive) against the Brand catalog at save time.
  // Null when the typed brand isn't a partnered brand yet — still useful
  // raw demand data, just not tied to a client account.
  brandId String?
  brandRef Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
}

// ──────────────────────────────────────────────
// AUDIT LOG — immutable trail of who did what
// ──────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?  // denormalised so log survives user deletion
  actorRole  String?

  action     String   // e.g. "store.create", "assessment.review", "store.redact_pii"
  entityType String   // "Store" | "Assessment" | "User"
  entityId   String

  // Optional before/after snapshot (JSON string) for key fields
  beforeJson String?
  afterJson  String?
  metaJson   String?  // free-form extra context

  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
